<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Layout_Config_Required</fullName>
    <!-- DEACTIVATED (final build, Phase A1.5): required the LEGACY storage
         field Layout_Config__c on publish. The final build stores layout in
         Form_Version__c.Spec_JSON__c (see Layout_Mode__c deprecation note);
         publishing a final form leaves this legacy field blank by design.
         Purge-bound with the rest of the legacy storage model. -->
    <active>false</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Published&quot;),
  ISBLANK(Layout_Config__c)
)</errorConditionFormula>
    <errorDisplayField>Layout_Config__c</errorDisplayField>
    <errorMessage
    >Layout Configuration is required for published forms</errorMessage>
</ValidationRule>
